# ============================================================================
# TrackNext Environment Configuration
# ============================================================================

# MongoDB Atlas Connection String
# 1. Create account: https://www.mongodb.com/cloud/atlas
# 2. Create cluster (free tier available)
# 3. Create database user
# 4. Get connection string from "Connect" button
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/tracknext?retryWrites=true&w=majority

# Database name (must exist in MongoDB)
MONGODB_DB_NAME=tracknext

# Server Configuration
PORT=3000
NODE_ENV=development

# Application Settings
# Seed database on startup if empty (true/false)
SEED_DATABASE=true
